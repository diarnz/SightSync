# ============================================================
# Frontend environment variables - copy this file to .env.local
# ============================================================

# Backend API base URL
# During local dev the Vite proxy rewrites /api to http://localhost:8000
# In production, point to your Cloud Run service URL:
# VITE_API_BASE_URL=https://your-service-xxxxx-uc.a.run.app
VITE_API_BASE_URL=/api
