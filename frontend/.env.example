# ============================================================
# Frontend environment variables – copy this file to .env.local
# and fill in your real values. .env.local is git-ignored.
# ============================================================

# Firebase project credentials (from Firebase Console → Project Settings)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Backend API base URL
# During local dev the Vite proxy rewrites /api → http://localhost:8000
# In production, point to your Cloud Run service URL:
# VITE_API_BASE_URL=https://your-service-xxxxx-uc.a.run.app
VITE_API_BASE_URL=/api
