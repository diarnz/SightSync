# ============================================================
# Backend environment variables – copy to backend/.env
# ============================================================

# OpenRouter API key (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=sk-or-v1-...

# OpenRouter model. Gemma 3 12B supports vision-language input.
OPENROUTER_MODEL=google/gemma-3-12b-it
OPENROUTER_FALLBACK_MODELS=google/gemma-3-27b-it

# Optional: Camb AI API key for server-generated WAV audio.
# If omitted, the frontend falls back to browser speech synthesis.
# CAMBAI_API_KEY=your_camb_ai_key

# Max image upload size (in MB)
MAX_IMAGE_SIZE_MB=10

# CORS – comma-separated list of allowed origins
# CORS_ORIGINS=["http://localhost:5173","https://your-frontend.web.app"]
