# ============================================================
# Backend environment variables – copy to backend/.env
# ============================================================

# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=GCP_API_KEY

# Optionally override the model (gemini-2.0-flash is fast & multimodal)
# GEMINI_MODEL=gemini-2.0-flash

# Max image upload size (in MB)
MAX_IMAGE_SIZE_MB=10

# CORS – comma-separated list of allowed origins
# CORS_ORIGINS=["http://localhost:5173","https://your-frontend.web.app"]
